# Set your password by running: node vendor-tool/set-password.js "your-password"
# (this writes the hashed value below automatically — never type a plain
# password directly into this file)
VENDOR_TOOL_PASSWORD_HASH=

# Optional overrides:
# VENDOR_TOOL_PORT=4100
# VENDOR_TOOL_SESSION_SECRET=some-long-random-string
# VENDOR_TOOL_PRIVATE_KEY_PATH=./license-private-key.pem
