<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid">
  <div class="admin-shell">
    <%- include('_sidebar') %>
    <main class="admin-main">
      <h4 class="mb-3"><i class="bi bi-stopwatch"></i> Priority SLA — Priorities &amp; Resolution Time Targets</h4>
      <p class="text-muted small" style="max-width:700px;">
        Set how many minutes a ticket has to be resolved in, based on its priority, and choose each
        priority's colour. A ticket turns 🟡 yellow once it passes 75% of its time, and 🔴 red once it
        passes 100% without being Resolved or Closed. <strong>Order</strong> decides where a priority
        appears in lists (lowest number first).
      </p>

      <% if (error) { %><div class="alert alert-danger py-2" style="max-width:760px;"><%= error %></div><% } %>
      <% if (success) { %><div class="alert alert-success py-2" style="max-width:760px;"><%= success %></div><% } %>

      <div class="card p-4 mb-3" style="max-width: 760px;">
        <form method="POST" action="/admin/priority-sla">
          <div class="table-responsive">
            <table class="table align-middle mb-3">
              <thead class="table-light">
                <tr><th style="width:80px;">Order</th><th>Priority</th><th style="width:210px;">Resolve within</th><th style="width:90px;">Colour</th><th style="width:50px;"></th></tr>
              </thead>
              <tbody>
                <% priorityRows.forEach(p => { %>
                  <tr>
                    <td><input type="number" min="0" max="9999" step="1" name="p[id_<%= p.id %>][order]" class="form-control form-control-sm" value="<%= p.sort_order %>" required></td>
                    <td>
                      <span class="priority-badge js-prio-badge" data-for="prio-color-<%= p.id %>"
                            style="background-color:<%= p.color %>;color:<%= p.textColor %>;"><%= p.priority %></span>
                      <% if (p.is_builtin) { %><span class="text-muted small ms-1">built-in</span><% } %>
                    </td>
                    <td>
                      <div class="input-group input-group-sm">
                        <input type="number" step="1" min="1" name="p[id_<%= p.id %>][minutes]" class="form-control" value="<%= Math.round(p.minutes) %>" required>
                        <span class="input-group-text">minutes</span>
                      </div>
                    </td>
                    <td><input type="color" id="prio-color-<%= p.id %>" name="p[id_<%= p.id %>][color]" class="form-control form-control-color form-control-sm" value="<%= p.color %>" title="Choose colour"></td>
                    <td class="text-end">
                      <% if (p.is_builtin) { %>
                        <i class="bi bi-lock text-muted" title="Built-in priorities can't be deleted"></i>
                      <% } else if (p.ticketCount || p.typeCount) { %>
                        <i class="bi bi-trash text-muted" title="In use by <%= p.ticketCount %> ticket(s) and <%= p.typeCount %> request type(s) — move them first"></i>
                      <% } else { %>
                        <button type="button" class="btn btn-sm btn-outline-danger js-delete-btn" data-form="del-prio-<%= p.id %>" data-label="priority &quot;<%= p.priority %>&quot;"><i class="bi bi-trash"></i></button>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-circle"></i> Save</button>
        </form>

        <% priorityRows.forEach(p => { if (!p.is_builtin && !p.ticketCount && !p.typeCount) { %>
          <form id="del-prio-<%= p.id %>" method="POST" action="/admin/priority-sla/<%= p.id %>/delete" class="d-none"></form>
        <% } }) %>
      </div>

      <div class="card p-4" style="max-width: 760px;">
        <h6 class="text-muted">Add Priority</h6>
        <form method="POST" action="/admin/priority-sla/add" class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label small mb-1">Name</label>
            <input type="text" name="name" class="form-control form-control-sm" maxlength="30" placeholder="e.g. Critical" value="<%= addValues.name %>" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small mb-1">Resolve within</label>
            <div class="input-group input-group-sm">
              <input type="number" step="1" min="1" name="minutes" class="form-control" placeholder="e.g. 60" value="<%= addValues.minutes %>" required>
              <span class="input-group-text">minutes</span>
            </div>
          </div>
          <div class="col-md-2">
            <label class="form-label small mb-1">Colour</label>
            <input type="color" name="color" class="form-control form-control-color form-control-sm" value="<%= addValues.color %>" title="Choose colour">
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-plus"></i> Add</button>
          </div>
        </form>
      </div>
    </main>
  </div>
</div>
<script src="/js/admin-sidebar.js"></script>
<script>
  // Live preview: recolour a priority's badge as soon as a new colour is picked.
  (function () {
    function textFor(hex) {
      var r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
      return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.62 ? '#212529' : '#ffffff';
    }
    document.querySelectorAll('.js-prio-badge').forEach(function (badge) {
      var input = document.getElementById(badge.dataset.for);
      if (!input) return;
      input.addEventListener('input', function () {
        badge.style.backgroundColor = input.value;
        badge.style.color = textFor(input.value);
      });
    });
  })();
</script>
<%- include('../partials/foot') %>
