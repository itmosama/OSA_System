<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid">
  <div class="admin-shell">
    <%- include('_sidebar') %>
    <main class="admin-main">
      <h4 class="mb-3"><i class="bi bi-building"></i> Room Types</h4>
      <p class="text-muted small" style="max-width:560px;">
        Define the categories of rooms in the hotel (e.g. Standard, Deluxe, Suite, Royal Suite).
        These show up when adding or editing a room.
      </p>

      <div class="row">
        <div class="col-md-5">
          <div class="card p-4 mb-3">
            <h6 class="text-muted">Add Room Type</h6>
            <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
            <form method="POST" action="/admin/room-types" class="d-flex gap-2">
              <input type="text" name="name" class="form-control" placeholder="e.g. Royal Suite" required>
              <button class="btn btn-primary" type="submit"><i class="bi bi-plus"></i></button>
            </form>
          </div>
        </div>
        <div class="col-md-7">
          <div class="card">
            <div class="table-responsive">
              <table class="table mb-0 align-middle">
                <thead class="table-light"><tr><th>Name</th><th>Rooms</th><th></th></tr></thead>
                <tbody>
                  <% if (roomTypes.length === 0) { %>
                    <tr><td colspan="3" class="text-center text-muted py-3">No room types yet.</td></tr>
                  <% } %>
                  <% roomTypes.forEach(rt => { %>
                    <tr>
                      <td>
                        <form method="POST" action="/admin/room-types/<%= rt.id %>/edit" class="d-flex gap-1">
                          <input type="text" name="name" class="form-control form-control-sm" value="<%= rt.name %>" required>
                          <button class="btn btn-sm btn-outline-primary" type="submit" title="Save"><i class="bi bi-check-lg"></i></button>
                        </form>
                      </td>
                      <td><%= rt.room_count %></td>
                      <td class="text-end">
                        <form method="POST" action="/admin/room-types/<%= rt.id %>/delete">
                          <button class="btn btn-sm btn-outline-danger js-delete-btn" type="button" data-label="room type &quot;<%= rt.name %>&quot;"><i class="bi bi-trash"></i></button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
<script src="/js/admin-sidebar.js"></script>
<%- include('../partials/foot') %>
