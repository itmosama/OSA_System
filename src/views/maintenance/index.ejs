<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-tools"></i> Preventive Maintenance</h4>
    <% if (currentUser.role === 'admin' || perms.can_manage_maintenance) { %>
      <a href="/maintenance/new" class="btn btn-primary"><i class="bi bi-plus-circle"></i> New Task</a>
    <% } %>
  </div>


  <div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
      <a href="/maintenance" class="status-tile <%= !filters.status ? 'active' : '' %>" style="--tile-color:#495057;">
        <div class="card h-100">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-grid-fill status-tile-icon"></i>
            <div class="osa-tile-line">
              <span class="osa-tile-name">All Tasks</span>
              <span class="osa-tile-num"><%= stats.total %></span>
            </div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-6 col-md-3">
      <div class="card h-100" style="--tile-color:#dc3545; border-left: 4px solid #dc3545;">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-exclamation-triangle-fill status-tile-icon" style="background:#dc3545;"></i>
          <div class="osa-tile-line">
              <span class="osa-tile-name">Overdue</span>
              <span class="osa-tile-num"><%= stats.overdue %></span>
            </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card h-100" style="--tile-color:#fd7e14; border-left: 4px solid #fd7e14;">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-clock-history status-tile-icon" style="background:#fd7e14;"></i>
          <div class="osa-tile-line">
              <span class="osa-tile-name">Due Soon (7 days)</span>
              <span class="osa-tile-num"><%= stats.dueSoon %></span>
            </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <a href="/maintenance?status=Completed" class="status-tile <%= filters.status === 'Completed' ? 'active' : '' %>" style="--tile-color:#198754;">
        <div class="card h-100">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill status-tile-icon"></i>
            <div class="osa-tile-line">
              <span class="osa-tile-name">Completed</span>
              <span class="osa-tile-num"><%= stats.completed %></span>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>

  <div class="card p-3 mb-3">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Status</label>
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All</option>
          <option value="Scheduled" <%= filters.status === 'Scheduled' ? 'selected' : '' %>>Scheduled</option>
          <option value="Completed" <%= filters.status === 'Completed' ? 'selected' : '' %>>Completed</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Department</label>
        <select name="department_id" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All</option>
          <% departments.forEach(d => { %>
            <option value="<%= d.id %>" <%= String(filters.department_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Frequency</label>
        <select name="frequency" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All</option>
          <% frequencies.forEach(f => { %>
            <option value="<%= f %>" <%= filters.frequency === f ? 'selected' : '' %>><%= f %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <a href="/maintenance" class="btn btn-sm btn-outline-secondary">Clear Filters</a>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Task #</th>
            <th>Equipment / Area</th>
            <th>Task</th>
            <th>Frequency</th>
            <th>Department</th>
            <th>Assigned To</th>
            <th>Next Due</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (tasks.length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">No maintenance tasks found.</td></tr>
          <% } %>
          <% tasks.forEach(t => { %>
            <tr class="<%= t.isOverdue ? 'table-danger' : (t.isDueSoon ? 'table-warning' : '') %>" style="cursor:pointer" onclick="location.href='/maintenance/<%= t.id %>'">
              <td class="text-muted"><%= t.task_number %></td>
              <td><%= t.equipment_area %></td>
              <td><%= t.task_description %></td>
              <td><%= t.frequency %></td>
              <td><%= t.department_name || '—' %></td>
              <td><%= t.assigned_to_name || '—' %></td>
              <td><%= t.next_due_date %><% if (t.isOverdue) { %> <span class="badge text-bg-danger">Overdue</span><% } else if (t.isDueSoon) { %> <span class="badge text-bg-warning text-dark">Due soon</span><% } %></td>
              <td><span class="badge <%= t.status === 'Completed' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= t.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>
<%- include('../partials/foot') %>
