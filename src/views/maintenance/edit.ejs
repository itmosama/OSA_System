<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container">
  <h4 class="mb-3"><i class="bi bi-pencil"></i> Edit <%= task.task_number %></h4>

  <div class="card p-4 mx-auto" style="max-width: 720px;">
    <% if (error) { %>
      <div class="alert alert-danger py-2"><%= error %></div>
    <% } %>
    <form method="POST" action="/maintenance/<%= task.id %>/edit">
      <div class="mb-3">
        <label class="form-label">Equipment / Area <span class="text-danger">*</span></label>
        <input type="text" name="equipment_area" class="form-control" value="<%= task.equipment_area %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Task Description <span class="text-danger">*</span></label>
        <textarea name="task_description" class="form-control" rows="3" required><%= task.task_description %></textarea>
      </div>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Frequency <span class="text-danger">*</span></label>
          <select name="frequency" class="form-select" required>
            <% frequencies.forEach(f => { %>
              <option value="<%= f %>" <%= task.frequency === f ? 'selected' : '' %>><%= f %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Next Due Date <span class="text-danger">*</span></label>
          <input type="date" name="next_due_date" class="form-control" value="<%= task.next_due_date %>" required>
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Department</label>
          <select name="department_id" class="form-select">
            <option value="">— None —</option>
            <% departments.forEach(d => { %>
              <option value="<%= d.id %>" <%= String(task.department_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Assigned To</label>
        <select name="assigned_to" class="form-select">
          <option value="">— Unassigned —</option>
          <% users.forEach(u => { %>
            <option value="<%= u.id %>" <%= String(task.assigned_to) === String(u.id) ? 'selected' : '' %>><%= u.full_name %></option>
          <% }) %>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Notes</label>
        <textarea name="notes" class="form-control" rows="2"><%= task.notes %></textarea>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save Changes</button>
        <a href="/maintenance/<%= task.id %>" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
