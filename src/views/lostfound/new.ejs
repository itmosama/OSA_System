<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container">
  <h4 class="mb-3"><i class="bi bi-binoculars"></i> Report Found Item</h4>

  <div class="card p-4 mx-auto" style="max-width: 720px;">
    <% if (error) { %>
      <div class="alert alert-danger py-2"><%= error %></div>
    <% } %>
    <form method="POST" action="/lost-found" enctype="multipart/form-data">
      <div class="mb-3">
        <label class="form-label">Item Description <span class="text-danger">*</span></label>
        <input type="text" name="item_description" class="form-control" placeholder="e.g. Black leather wallet, iPhone 14, gold earring"
               value="<%= values.item_description %>" required>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Room Number / Location Found</label>
          <input type="text" name="location" class="form-control" list="roomsDatalist"
                 placeholder="Room number, or e.g. Pool area, Lobby, Restaurant..." value="<%= values.location %>">
          <datalist id="roomsDatalist">
            <% rooms.forEach(r => { %>
              <option value="<%= r.number %>">
            <% }) %>
          </datalist>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Found By</label>
          <input type="text" name="found_by_name" class="form-control" placeholder="Staff member's name" value="<%= values.found_by_name %>">
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Date &amp; Time Found</label>
        <input type="datetime-local" name="found_at" class="form-control" value="<%= values.found_at %>">
        <div class="form-text">Leave blank if unknown — you can add it later.</div>
      </div>

      <div class="mb-3">
        <label class="form-label">Description / Notes</label>
        <textarea name="description" class="form-control" rows="4" placeholder="Any identifying details, condition, contents, etc."><%= values.description %></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Photos <span class="text-muted small">(optional)</span></label>
        <input type="file" name="photos" class="form-control" accept="image/*" multiple>
        <div class="form-text">
          <i class="bi bi-camera"></i> Take a photo of the item or upload one. Up to 6 photos, 10MB each.
        </div>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Save Item</button>
        <a href="/lost-found" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
