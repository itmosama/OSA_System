<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container">
  <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
      <div class="text-muted small"><%= item.serial_number %></div>
      <h4 class="mb-0"><%= item.item_description %></h4>
    </div>
    <div class="text-end">
      <div>
        <% if (item.guest_contacted) { %>
          <span class="badge text-bg-success"><i class="bi bi-check-lg"></i> Guest contacted</span>
        <% } else { %>
          <span class="badge text-bg-secondary">Guest not contacted</span>
        <% } %>
      </div>
      <div class="mt-2 d-flex gap-2 justify-content-end align-items-center">
        <span class="badge status-badge-<%= item.status.replace(/ /g,'-') %> fs-6"><%= item.status %></span>
        <% if (perms.can_edit_delete_lost_found) { %>
          <button type="button" class="btn btn-sm btn-outline-danger js-delete-btn"
                  data-form="delete-item-form" data-label="lost & found item <%= item.serial_number %>">
            <i class="bi bi-trash"></i> Delete
          </button>
        <% } %>
      </div>
    </div>
  </div>
  <% if (perms.can_edit_delete_lost_found) { %>
    <form id="delete-item-form" method="POST" action="/lost-found/<%= item.id %>/delete" class="d-none"></form>
  <% } %>

  <div class="row">
    <div class="col-lg-8">
      <div class="card p-4 mb-3">
        <h6 class="text-muted">Description</h6>
        <p style="white-space: pre-wrap;"><%= item.description || '—' %></p>

        <% if (item.contact_notes) { %>
          <h6 class="text-muted mt-3">Guest Contact Notes</h6>
          <p style="white-space: pre-wrap;"><%= item.contact_notes %></p>
        <% } %>

        <% if (itemPhotos.length) { %>
          <h6 class="text-muted mt-3 mb-2"><i class="bi bi-camera"></i> Photos (<%= itemPhotos.length %>)</h6>
          <div class="d-flex flex-wrap gap-2">
            <% itemPhotos.forEach(p => { %>
              <img src="/uploads/<%= p.filename %>" data-full-src="/uploads/<%= p.filename %>" alt="Item photo"
                   class="rounded border photo-thumb" style="width:110px; height:110px; object-fit:cover;">
            <% }) %>
          </div>
        <% } %>
      </div>

      <div class="card p-4">
        <h6 class="text-muted mb-3">Activity</h6>
        <% comments.forEach(c => { %>
          <div class="mb-3 <%= c.is_system ? 'text-muted small fst-italic' : '' %>">
            <% if (!c.is_system) { %>
              <div class="fw-semibold small"><%= c.author_name %> <span class="text-muted fw-normal">· <%= c.created_at %></span></div>
            <% } else { %>
              <div class="small"><i class="bi bi-arrow-repeat"></i> <%= c.body %> — <%= c.author_name %>, <%= c.created_at %></div>
            <% } %>
            <% if (!c.is_system) { %>
              <div style="white-space: pre-wrap;"><%= c.body %></div>
              <% if (attachmentsByComment[c.id]) { %>
                <div class="d-flex flex-wrap gap-2 mt-2">
                  <% attachmentsByComment[c.id].forEach(p => { %>
                    <img src="/uploads/<%= p.filename %>" data-full-src="/uploads/<%= p.filename %>" alt="Attached photo"
                         class="rounded border photo-thumb" style="width:90px; height:90px; object-fit:cover;">
                  <% }) %>
                </div>
              <% } %>
            <% } %>
          </div>
        <% }) %>
        <% if (comments.length === 0) { %>
          <p class="text-muted small">No activity yet.</p>
        <% } %>

        <form method="POST" action="/lost-found/<%= item.id %>/comments" enctype="multipart/form-data" class="mt-3 border-top pt-3">
          <div class="mb-2">
            <textarea name="body" class="form-control" rows="3" placeholder="Add an update..."></textarea>
          </div>
          <div class="mb-2">
            <label class="form-label small text-muted mb-1"><i class="bi bi-camera"></i> Attach photo(s) <span class="text-muted">(optional)</span></label>
            <input type="file" name="photos" class="form-control form-control-sm" accept="image/*" multiple>
          </div>
          <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-chat-left-text"></i> Post Update</button>
        </form>
      </div>
    </div>

    <div class="col-lg-4">
      <% if (createdAtIso) { %>
      <div class="card p-4 mb-3" data-ticket-timer data-created-at="<%= createdAtIso %>" data-finished="0">
        <h6 class="text-muted mb-2"><i class="bi bi-hourglass-split"></i> Time In Storage</h6>
        <div class="fs-5 fw-semibold ticket-elapsed">—</div>
        <div class="text-muted small">Since logged into the system on <%= item.created_at %></div>
      </div>
      <% } %>

      <div class="card p-4 mb-3">
        <h6 class="text-muted mb-3">Details</h6>
        <dl class="row mb-0 small">
          <dt class="col-5">Location Found</dt><dd class="col-7"><%= item.location || '—' %></dd>
          <dt class="col-5">Found By</dt><dd class="col-7"><%= item.found_by_name || '—' %></dd>
          <dt class="col-5">Date/Time Found</dt><dd class="col-7"><%= item.found_at || '—' %></dd>
          <dt class="col-5">Logged By</dt><dd class="col-7"><%= item.logged_by_name %></dd>
          <dt class="col-5">Logged At</dt><dd class="col-7"><%= item.created_at %></dd>
          <dt class="col-5">Updated</dt><dd class="col-7"><%= item.updated_at %></dd>
        </dl>
      </div>

      <% if (currentUser.role === 'admin' || currentUser.role === 'agent' || perms.can_manage_lost_found) { %>
      <div class="card p-4">
        <h6 class="text-muted mb-3">Manage Item</h6>
        <form method="POST" action="/lost-found/<%= item.id %>/update">
          <div class="mb-2">
            <label class="form-label small">Status</label>
            <select name="status" class="form-select form-select-sm">
              <% statuses.forEach(s => { %>
                <option value="<%= s %>" <%= item.status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-2 form-check">
            <input type="checkbox" name="guest_contacted" value="1" class="form-check-input" id="guestContacted" <%= item.guest_contacted ? 'checked' : '' %>>
            <label class="form-check-label small" for="guestContacted">Guest has been contacted</label>
          </div>
          <div class="mb-3">
            <label class="form-label small">Guest Contact Notes</label>
            <textarea name="contact_notes" class="form-control form-control-sm" rows="3" placeholder="How/when the guest was contacted, outcome, etc."><%= item.contact_notes || '' %></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-sm w-100">Save Changes</button>
        </form>
      </div>
      <% } %>
    </div>
  </div>
</div>
<script src="/js/ticket-timer.js"></script>
<script src="/js/lightbox.js"></script>
<%- include('../partials/foot') %>
