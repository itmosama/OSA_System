<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container">
  <%
    const statusMeta = {
      'Draft':            { icon: 'bi-file-earmark',   color: '#6c757d' },
      'Pending HOD':      { icon: 'bi-person-check',   color: '#fd7e14' },
      'Pending Finance':  { icon: 'bi-cash-coin',      color: '#6f42c1' },
      'Pending IT':       { icon: 'bi-inbox',          color: '#0d6efd' },
      'In Progress':      { icon: 'bi-gear-wide-connected', color: '#0dcaf0' },
      'Completed':        { icon: 'bi-check-circle-fill', color: '#198754' },
      'Returned to HR':   { icon: 'bi-arrow-return-left', color: '#dc3545' },
      'Cancelled':        { icon: 'bi-slash-circle',   color: '#343a40' },
    };
    const tileStatuses = ['Pending HOD', 'Pending Finance', 'Pending IT', 'In Progress', 'Completed', 'Returned to HR'];
  %>

  <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-signpost-split"></i> Workflow Requests</h4>
    <% if (canCreate) { %>
      <a href="/workflow-requests/new" class="btn btn-primary"><i class="bi bi-plus-circle"></i> New Request</a>
    <% } %>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-6 col-md-3">
      <a href="/workflow-requests?filter=awaiting" class="status-tile <%= filters.filter === 'awaiting' ? 'active' : '' %>" style="--tile-color:#dc3545;">
        <div class="card h-100">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-bell-fill status-tile-icon"></i>
            <div class="osa-tile-line"><span class="osa-tile-name">Waiting for me</span><span class="osa-tile-num"><%= awaitingCount %></span></div>
          </div>
        </div>
      </a>
    </div>
    <% tileStatuses.forEach(s => { const m = statusMeta[s]; %>
      <div class="col-6 col-md-3">
        <a href="/workflow-requests?status=<%= encodeURIComponent(s) %>" class="status-tile <%= filters.status === s ? 'active' : '' %>" style="--tile-color:<%= m.color %>;">
          <div class="card h-100">
            <div class="d-flex align-items-center gap-2">
              <i class="bi <%= m.icon %> status-tile-icon"></i>
              <div class="osa-tile-line"><span class="osa-tile-name"><%= s %></span><span class="osa-tile-num"><%= counts[s] || 0 %></span></div>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>

  <div class="card p-3 mb-3">
    <form method="GET" class="row g-2 align-items-end">
      <% if (filters.filter) { %><input type="hidden" name="filter" value="<%= filters.filter %>"><% } %>
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Status</label>
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All</option>
          <% allStatuses.forEach(s => { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Department</label>
        <select name="department_id" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All</option>
          <% departments.forEach(d => { %>
            <option value="<%= d.id %>" <%= String(filters.department_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1">Search</label>
        <input type="text" name="q" class="form-control form-control-sm" placeholder="Title, reference or person..." value="<%= filters.q %>">
      </div>
      <div class="col-md-2 d-flex gap-1">
        <button class="btn btn-sm btn-primary flex-fill" type="submit">Search</button>
        <a href="/workflow-requests" class="btn btn-sm btn-outline-secondary">Clear</a>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Reference</th><th>Title</th><th>Department</th><th>Priority</th><th>Cost</th><th>Needed by</th><th>Status</th><th>Raised by</th><th>Updated</th>
          </tr>
        </thead>
        <tbody>
          <% if (requests.length === 0) { %>
            <tr><td colspan="9" class="text-center text-muted py-4">No workflow requests found.</td></tr>
          <% } %>
          <% requests.forEach(r => { const m = statusMeta[r.status] || statusMeta['Draft']; %>
            <tr style="cursor:pointer" onclick="location.href='/workflow-requests/<%= r.id %>'">
              <td class="text-muted text-nowrap"><%= r.reference_number %></td>
              <td><%= r.title %></td>
              <td><%= r.department_name || '—' %></td>
              <td><%- include('../partials/priority-badge', { name: r.priority }) %></td>
              <td class="text-nowrap"><%= r.has_cost ? Number(r.cost_amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : '—' %></td>
              <td class="text-nowrap"><%= r.needed_by || '—' %></td>
              <td><span class="badge" style="background-color:<%= m.color %>;"><i class="bi <%= m.icon %>"></i> <%= r.status %></span></td>
              <td><%= r.created_by_name || '—' %></td>
              <td class="text-muted small text-nowrap"><%= r.updated_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
