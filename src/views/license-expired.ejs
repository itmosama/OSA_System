<%- include('partials/head') %>
<div class="login-wrapper">
  <div class="card p-4 p-md-5 text-center" style="width: 100%; max-width: 460px;">
    <i class="bi bi-exclamation-octagon-fill text-danger" style="font-size: 3rem;"></i>
    <h4 class="mt-3">System Unavailable</h4>
    <% if (!status.activated) { %>
      <p class="text-muted">This system has not been activated yet. Please contact your administrator.</p>
    <% } else if (status.expired) { %>
      <p class="text-muted">The license for this system expired on <strong><%= status.expires %></strong>. Please contact your administrator to renew it.</p>
    <% } else { %>
      <p class="text-muted">This system's license could not be verified. Please contact your administrator.</p>
    <% } %>
    <form action="/logout" method="POST" class="mt-3">
      <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-box-arrow-right"></i> Sign Out</button>
    </form>
  </div>
</div>
<%- include('partials/foot') %>
